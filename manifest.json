{
  "manifest_version": 3,
  "name": "LinkRadar",
  "version": "0.2.1",
  "version_name": "beta 0.2.1",
  "minimum_chrome_version": "102",
  "description": "Находит ссылки на соцсети, телефоны, email, ИНН и ОГРН по клику пользователя",
  "permissions": ["activeTab", "scripting", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "update_url": "https://github.com/Vitalijan/LinkRadar/archive/refs/heads/main.zip",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Запустить LinkRadar (beta 0.2.1)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
